config_version=5

[application]
config/name="IOS_CONDO_BLOX"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "Mobile")

[input]

move_left={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":0.0,"axis_value":-1.0)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":0.0,"axis_value":1.0)]
}
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":1.0,"axis_value":-1.0)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventJoypadMotion,"axis":1.0,"axis_value":1.0)]
}
jump={
"deadzone": 0.5,
"events": [Object(InputEventKey,"physical_keycode":32)]
}

[rendering]
renderer/rendering_method="mobile"
